{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start.sh",
            "async": true,
            "statusMessage": "Starting local stack (docker compose + pnpm dev)..."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-end.sh",
            "timeout": 30,
            "statusMessage": "Stopping local stack (docker compose + pnpm dev)..."
          }
        ]
      }
    ]
  }
}
