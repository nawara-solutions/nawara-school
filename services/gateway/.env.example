PORT=3000

# Gateway is stateless — routing, token validation, rate limiting only.
# No DATABASE_URL: it owns no schema (CLAUDE.md §2).
JWT_PUBLIC_KEY=

# Rate limiting (CLAUDE.md §2)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Downstream service base URLs for routing
AUTH_SERVICE_URL=http://localhost:3001
NOTIFICATION_SERVICE_URL=http://localhost:3002
USER_SERVICE_URL=http://localhost:3003
CHILD_SERVICE_URL=http://localhost:3004
CLASSROOM_SERVICE_URL=http://localhost:3005
ATTENDANCE_SERVICE_URL=http://localhost:3006
